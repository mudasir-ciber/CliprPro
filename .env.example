# Copy to .env and edit only if needed. Never commit .env.

# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# JOBS_DIR=jobs
# CHROMIUM_NO_SANDBOX=1
# CHROMIUM_PATH=
# CHROME_PATH=

# Phase 2 analysis
# TRANSCRIPTION_ENGINE=estimated
# TRANSCRIPTION_ENGINE=whisper
# TRANSCRIPTION_LANGUAGE=en
# WHISPER_MODEL=Xenova/whisper-tiny.en
# HOOK_WINDOW_SEC=15
# ALIGNMENT_THRESHOLD=0.45
# SILENCE_NOISE_DB=-30
# MIN_SILENCE_SEC=0.25
# DEBUG=1

# Phase 3 storyboard
# STORYBOARD_PLANNER=heuristic
# STORYBOARD_PLANNER=llm
# STORYBOARD_PLANNER=auto
# STORYBOARD_API_KEY=
# OPENAI_API_KEY=
# STORYBOARD_API_URL=https://api.openai.com/v1
# STORYBOARD_MODEL=gpt-4o-mini
# SKIP_STORYBOARD=0

# Phase 7 visual QC
# SKIP_QC=0
# QC_STRICT=0
# QC_FAIL_ON_ERROR=1
# QC_MAX_SAMPLES=24
# QC_BLACK_LUMA=12
# QC_LOW_VARIANCE=40
# QC_CONTACT_SHEET=1

# Phase 8 self-repair
# SKIP_REPAIR=0
# REPAIR_MAX_ATTEMPTS=2
# REPAIR_ON_WARNINGS=0

# Phase 9 long-form render
# RENDER_WORKERS=1
# RENDER_CHUNK_SIZE=90
# RENDER_RESUME=1
# LONG_FORM_AUTO=1
# LONG_FORM_MIN_FRAMES=120
# LONG_FORM_WORKERS=2

# Phase 10 packaging
# SKIP_PACKAGE=0
