# Copy this file to .env and edit only if needed. Never commit .env.
# Full path to ffmpeg/ffprobe if they are not on PATH (Windows example):
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Where job folders are created (default: ./jobs)
# JOBS_DIR=jobs

# Linux/Docker/root only: launch Chromium with --no-sandbox
# CHROMIUM_NO_SANDBOX=1
